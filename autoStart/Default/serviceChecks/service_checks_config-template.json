{
  "checks": {
    "mount_drives": {
      "service": "mount_drives.service",
      "description": "Mount Drives",
      "type": "Startup",
      "status": {
        "0": {
          "result": "PASS",
          "class": "pass",
          "description": "Mount drives completed successfully."
        },
        "1": {
          "result": "FAIL",
          "class": "fail",
          "description": "Mount drives configuration failed."
        }
      }
    },
    "plex_rename_folders": {
      "service": "plex_rename_folders.service",
      "description": "Plex Rename Folders",
      "type": "Startup",
      "status": {
        "0": {
          "result": "PASS",
          "class": "pass",
          "description": "Plex folder rename completed successfully."
        },
        "1": {
          "result": "FAIL",
          "class": "fail",
          "description": "Plex folder rename configuration failed."
        }
      }
    },
    "update_plex_permissions": {
      "service": "update_plex_permissions.service",
      "description": "Plex Permissions",
      "type": "Startup",
      "status": {
        "0": {
          "result": "PASS",
          "class": "pass",
          "description": "Plex permissions update completed successfully."
        },
        "1": {
          "result": "FAIL",
          "class": "fail",
          "description": "Plex permissions configuration failed."
        }
      }
    },
    "plex_refresh": {
      "service": "plex_refresh.service",
      "description": "Plex Refresh",
      "type": "Startup",
      "status": {
        "0": {
          "result": "PASS",
          "class": "pass",
          "description": "Plex metadata refresh completed successfully."
        },
        "1": {
          "result": "FAIL",
          "class": "fail",
          "description": "Plex refresh configuration or token setup failed."
        },
        "2": {
          "result": "FAIL",
          "class": "fail",
          "description": "One or more Plex metadata refresh operations failed."
        }
      }
    },
    "archive_backup": {
      "service": "archive_backup.service",
      "description": "Archive Backup",
      "type": "Shutdown",
      "status_file": "/var/lib/service_checks/archive_backup.status",
      "status": {
        "0": {
          "result": "PASS",
          "class": "pass",
          "description": "Archive backup completed successfully."
        },
        "1": {
          "result": "FAIL",
          "class": "fail",
          "description": "Archive backup service failed during shutdown."
        },
        "2": {
          "result": "FAIL",
          "class": "fail",
          "description": "Archive backup configuration or setup failed."
        },
        "3": {
          "result": "SKIP",
          "class": "skip",
          "description": "Archive backup was not due."
        },
        "130": {
          "result": "FAIL",
          "class": "fail",
          "description": "Archive backup was interrupted."
        }
      }
    },
    "snapshot_backup": {
      "service": "snapshot_backup.service",
      "description": "Snapshot Backup",
      "type": "Shutdown",
      "status_file": "/var/lib/service_checks/snapshot_backup.status",
      "status": {
        "0": {
          "result": "PASS",
          "class": "pass",
          "description": "Snapshot backup completed successfully."
        },
        "1": {
          "result": "FAIL",
          "class": "fail",
          "description": "Snapshot backup service failed during shutdown."
        },
        "2": {
          "result": "FAIL",
          "class": "fail",
          "description": "Snapshot backup configuration or setup failed."
        },
        "3": {
          "result": "SKIP",
          "class": "skip",
          "description": "Snapshot backup was not due."
        },
        "130": {
          "result": "FAIL",
          "class": "fail",
          "description": "Snapshot backup was interrupted."
        }
      }
    }
  }
}
