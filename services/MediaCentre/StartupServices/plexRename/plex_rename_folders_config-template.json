{
  "plex_folder_locs": {
    "/mnt/plexmedia/PlexMedia/Movies": {
      "include_files": true,
      "expand_subfolders": true,
      "expand_exceptions": ["Subs", "Subtitles", "Extras", "Artwork"],
      "suffixes": ["(\\([12][0-9]{3}\\)|[\\s\\-][12][0-9]{3})"],
      "suffix_exceptions": ["Blade Runner 2049 (2017)",
                            "Wonder Woman 1984 (2020)"],
      "char_replacements": {
        "^(www\\.UIndex\\.org[\\s]*-[\\s]*)": "",
        "\\.": " ",
        " 20([0-9]{2})$": " (20\\1)",
        " 19([0-9]{2})$": " (19\\1)"
      },
      "replace_order": [
        "^(www\\.UIndex\\.org[\\s]*-[\\s]*)",
        "\\.",
        " 20([0-9]{2})$",
        " 19([0-9]{2})$"
      ],
      "replace_exceptions": ["A.I. Artificial Intelligence (2001)"],
      "remove_empty_folders": true,
      "remove_empty_exceptions": ["Subs", "Subtitles", "Extras", "Artwork"],
      "remove_dir": "/mnt/plexmedia/PlexMedia/.removed/plex/Movies/",
      "remove_dir_folder_name": "plexRemovedFolders-Movies",
      "remove_dir_folder_compress": true,
      "remove_folder_copies" : 10,
      "folder_organization": {
        ".srt": "Subs"
      }
    },
    "/mnt/plexmedia/PlexMedia/TV Series": {
