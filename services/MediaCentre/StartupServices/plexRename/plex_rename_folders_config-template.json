      ],
      "suffix_exceptions": [],
      "char_replacements": {
        "\\.": " ",
        "(?i)\\bs(\\d{2})e(\\d{2})\\b": "S\\1E\\2",
        " 20([0-9]{2})$": " (20\\1)",
        " 19([0-9]{2})$": " (19\\1)"
      },
      "replace_order": [
        "\\.",
        "(?i)\\bs(\\d{2})e(\\d{2})\\b",
        " 20([0-9]{2})$",
        " 19([0-9]{2})$"
      ],
      "replace_exceptions": [],
      "remove_empty_folders": true,
