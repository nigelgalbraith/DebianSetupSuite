[Unit]
Description=Refresh Plex Meta Data
Wants=network-online.target
After=network-online.target mount_drives.service plex_rename_folders.service update_plex_permissions.service
Requires=mount_drives.service plex_rename_folders.service update_plex_permissions.service

# Ensure all Plex directories are mounted before running
RequiresMountsFor=/mnt/plexmedia/PlexMedia
RequiresMountsFor=/mnt/plexmedia/PlexMedia/Backup
RequiresMountsFor=/mnt/plexmedia/PlexMedia/Movies
RequiresMountsFor=/mnt/plexmedia/PlexMedia/Music
RequiresMountsFor=/mnt/plexmedia/PlexMedia/Other\x20Videos
RequiresMountsFor=/mnt/plexmedia/PlexMedia/Photos
RequiresMountsFor=/mnt/plexmedia/PlexMedia/TV\x20Series

# Only run if the main mount point exists
ConditionPathIsMountPoint=/mnt/plexmedia/PlexMedia

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 10
ExecStart=/usr/bin/python3 /usr/local/bin/plex_refresh.py
StandardOutput=append:/var/log/plex_refresh.log
StandardError=append:/var/log/plex_refresh.log
RemainAfterExit=true
User=root
Group=root
Environment="PYTHONUNBUFFERED=1" "LANG=C.UTF-8" "LC_ALL=C.UTF-8"

[Install]
WantedBy=multi-user.target
