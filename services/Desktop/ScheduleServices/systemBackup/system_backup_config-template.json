{
  "backup_jobs": {
    "debian_system": {
      "source_dir": "/",
      "destination_dir": "/mnt/nigel/backups/System",
      "mirror": true,
      "one_file_system": true,
      "exclude": [
        "/dev/***",
        "/proc/***",
        "/sys/***",
        "/run/***",
        "/tmp/***",
        "/mnt/***",
        "/media/***",
        "/lost+found",
        "/swapfile",
        "/var/tmp/***",
        "/home/*/.cache/***",
        "/home/*/.local/share/Trash/***"
      ],
      "backupGroup": "backup",
      "backupUsers": ["nigel"],
      "protected_folder": {
          "owner": "root",
          "group": "backup",
          "permissions": "2775"
      }
    },

    "user_data": {
      "source_dir": "/mnt/nigel/userData",
      "destination_dir": "/mnt/nigel/backups/userData",
      "mirror": true,
      "one_file_system": true,
      "exclude": [
        "/lost+found",
        "/.Trash-*/***",
        "/.Trash/***"
      ],
      "backupGroup": "backup",
      "backupUsers": ["nigel"],
      "protected_folder": {
          "owner": "root",
          "group": "backup",
          "permissions": "2775"
      }
    }
  }
}