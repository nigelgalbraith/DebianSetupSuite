
{
  "backup_jobs": {
    "SYSTEM_JOB_NAME": {
      "source_dir": "/",
      "destination_dir": "/path/to/system/backup",
      "mirror": true,
      "one_file_system": true,
      "exclude": [
        "/dev/***",
        "/proc/***",
        "/sys/***",
        "/run/***",
        "/tmp/***",
        "/mnt/***",
        "/media/***",
        "/lost+found",
        "/swapfile",
        "/var/tmp/***",
        "/home/*/.cache/***",
        "/home/*/.local/share/Trash/***"
      ],
      "backupGroup": "backup",
      "backupUsers": [
        "USERNAME"
      ],
      "protected_folder": {
        "owner": "root",
        "group": "backup",
        "permissions": "2775"
      }
    },

    "DATA_JOB_NAME": {
      "source_dir": "/path/to/source/data",
      "destination_dir": "/path/to/data/backup",
      "mirror": true,
      "one_file_system": true,
      "exclude": [
        "/lost+found",
        "/.Trash-*/***",
        "/.Trash/***"
      ],
      "backupGroup": "backup",
      "backupUsers": [
        "USERNAME"
      ],
      "protected_folder": {
        "owner": "root",
        "group": "backup",
        "permissions": "2775"
      }
    }
  }
}
