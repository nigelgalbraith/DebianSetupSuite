
{
  "backup_jobs": {
    "SERVICE_JOB_NAME": {
      "source_dir": "/path/to/application/data",
      "backup_root": "/path/to/backup/destination",
      "keep": 3,
      "archive_prefix": "config",
      "format": "tar.gz",
      "stop_service": "SERVICE_NAME",
      "timeout_stop_sec": 30,
      "backupFrequency": "Daily",
      "backupGroup": "backup",
      "backupUsers": [
        "USERNAME"
      ],
      "protected_folder": {
        "owner": "root",
        "group": "backup",
        "permissions": "2775"
      }
    },

    "APPLICATION_JOB_NAME": {
      "source_dir": "/path/to/application/config",
      "backup_root": "/path/to/backup/destination",
      "keep": 3,
      "archive_prefix": "config",
      "format": "tar.gz",
      "stop_service": "",
      "timeout_stop_sec": 0,
      "backupFrequency": "Daily",
      "backupGroup": "backup",
      "backupUsers": [
        "USERNAME"
      ],
      "protected_folder": {
        "owner": "root",
        "group": "backup",
        "permissions": "2775"
      }
    }
  }
}
