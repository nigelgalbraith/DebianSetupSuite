[Unit]
Description=snapshot_backup
DefaultDependencies=no
RequiresMountsFor=/mnt/storage/Backup
After=local-fs.target mount_drives.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/install -d -m 0755 /var/lib/service_checks
ExecStart=/bin/true
ExecStop=/bin/sh -c '/usr/bin/python3 -u /usr/local/bin/snapshot_backup.py; code=$$?; /usr/bin/echo "$$code|$$(/usr/bin/date -Is)" > /var/lib/service_checks/snapshot_backup.status; /usr/bin/chmod 0644 /var/lib/service_checks/snapshot_backup.status; exit $$code'
User=root
Group=root
Environment="PYTHONUNBUFFERED=1" "LANG=C.UTF-8" "LC_ALL=C.UTF-8"
StandardOutput=append:/var/log/snapshot_backup.log
StandardError=append:/var/log/snapshot_backup.log
TimeoutStopSec=30min
SuccessExitStatus=3

[Install]
WantedBy=multi-user.target
