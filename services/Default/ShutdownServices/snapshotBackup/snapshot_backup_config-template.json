{
  "backup_jobs": {
    "JOB_NAME": {
      "source_dir": "/path/to/source",
      "backup_root": "/path/to/backup/destination",
      "keep": 3,
      "snapshot_prefix": "SNAPSHOT_NAME",
      "backupFrequency": "Daily",
      "backupGroup": "backup",
      "backupUsers": [
        "USERNAME"
      ],
      "exclude": [
        ".cache/",
        "Downloads/",
        ".local/share/Trash/",
        "thinclient_drives/"
      ],
      "protected_folder": {
        "owner": "root",
        "group": "backup",
        "permissions": "2775"
      }
    }
  }
}
