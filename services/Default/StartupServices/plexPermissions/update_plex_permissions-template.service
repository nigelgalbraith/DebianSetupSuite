[Unit]
Description=Update Plex Media Drive Permissions
Wants=network-online.target
After=network-online.target mount_drives.service plex_rename_folders.service
Requires=mount_drives.service plex_rename_folders.service

# Ensure all Plex directories are mounted before running
RequiresMountsFor=/mnt/user/PlexMedia
RequiresMountsFor=/mnt/storage/Backup
RequiresMountsFor=/mnt/storage/Movies
RequiresMountsFor=/mnt/storage/Music
RequiresMountsFor=/mnt/storage/Other\x20Videos
RequiresMountsFor=/mnt/storage/Photos
RequiresMountsFor=/mnt/storage/TV\x20Series

# Only run if the main mount point exists
ConditionPathIsMountPoint=/mnt/user/PlexMedia

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/update_plex_permissions.py
StandardOutput=append:/var/log/update_plex_permissions.log
StandardError=append:/var/log/update_plex_permissions.log
RemainAfterExit=true
User=root
Group=root
Environment="PYTHONUNBUFFERED=1" "LANG=C.UTF-8" "LC_ALL=C.UTF-8"

[Install]
WantedBy=multi-user.target
